<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DayDrop" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.DayDrop.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_drop</item>
        <item name="postSplashScreenTheme">@style/Theme.DayDrop</item>
    </style>
</resources>
